# ESP32-P4 (Waveshare ESP32-P4-WiFi6-Touch-LCD-7B) defaults
# Applied by `idf.py set-target esp32p4` from the firmware/ directory.

# Target / CPU
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
# Waveshare 7B ships ESP32-P4 silicon rev v1.3 (esptool: v1.3); IDF 5.3
# caps support at v0.99, v5.4+ supports v1.x — pin minimum rev to v1.0.
CONFIG_ESP32P4_REV_MIN_100=y

# Flash & PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# 200 MHz PSRAM clock is gated behind experimental features in IDF 5.4
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# L2 cache settings from Waveshare's LVGL example (UI smoothness)
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Main task needs headroom for LVGL/BSP init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# Keep the bootloader small (partition table starts at 0x8000)
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# FreeRTOS tick for smooth UI
CONFIG_FREERTOS_HZ=1000

# LVGL 9 (BSP-managed adapter): C allocators, 15 ms refresh, 2 draw units
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y

# Wi-Fi via ESP32-C6 co-processor (ESP-Hosted)

# USB-Serial-JTAG console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Dual OTA partitions + rollback (PRD §22)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Watchdog
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
