# ESP32-P4 (Waveshare ESP32-P4-WiFi6-Touch-LCD-7B) defaults
# Applied by `idf.py set-target esp32p4 && idf.py sdkconfig`

# Target / CPU
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Flash & PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_200M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# FreeRTOS tick for smooth UI
CONFIG_FREERTOS_HZ=1000

# Wi-Fi via ESP32-C6 co-processor (ESP-Hosted)
CONFIG_ESP_HOSTED_ENABLED=y

# USB OTG host for keyboard/mouse HID
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Dual OTA partitions + rollback (PRD §22)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_OTA_ALLOW_HTTP=n

# Watchdog
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
